FLASK_DEBUG=false
PROVIDER=gemini
MODEL=gemini-3.1-pro-preview

# Gemini API key (get yours at https://aistudio.google.com/apikey):
GEMINI_API_KEY=

# Web search routing: gemini | auto | ollama | tavily | off
WEB_SEARCH_PROVIDER=gemini
GEMINI_WEB_SEARCH_ENABLED=true
GEMINI_WEB_SEARCH_MAX_RESULTS=5
GEMINI_WEB_SEARCH_MODEL=

# OpenRouter API key (optional if switching PROVIDER=openrouter):
OPENROUTER_API_KEY=

# News Generator fallback when not using Gemini Google Search:
TAVILY_API_KEY=
TAVILY_SEARCH_MAX_RESULTS=5
TAVILY_SEARCH_TIME_RANGE=week

# Set this only if you use OpenAI:
OPENAI_API_KEY=

# For Ollama on your host machine:
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: Ollama web search (keep false when using Gemini Google Search).
OLLAMA_API_KEY=
OLLAMA_WEB_SEARCH_ENABLED=false
OLLAMA_WEB_SEARCH_MAX_RESULTS=5

# Total attempts for model JSON responses and content validation retries.
JSON_GENERATION_ATTEMPTS=2
GENERATION_MAX_ATTEMPTS=5
