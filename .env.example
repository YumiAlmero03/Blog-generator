FLASK_DEBUG=false
PROVIDER=ollama
MODEL=qwen3:8b

# Set these only if you use them.
OPENAI_API_KEY=
GEMINI_API_KEY=

# For Ollama on your host machine:
OLLAMA_HOST=http://host.docker.internal:11434

# Optional: Ollama web search for current web context.
# You can also save this key on the Settings page.
OLLAMA_API_KEY=
OLLAMA_WEB_SEARCH_ENABLED=true
OLLAMA_WEB_SEARCH_MAX_RESULTS=5

# Total attempts for model JSON responses. If the first output is invalid JSON,
# the app retries generation with stricter JSON-only instructions.
JSON_GENERATION_ATTEMPTS=2
